/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/rearena-pocket/dice-charge-battle/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/rearena-pocket/dice-charge-battle/assets/*
  Cache-Control: public, max-age=3600

/coyote-remote/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
